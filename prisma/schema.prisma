generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth (NextAuth) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts       Account[]
  sessions       Session[]
  memberships    Membership[]
  participations Participation[]
  payments       Payment[]
  auditLogs      AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Domain ----------

enum MembershipRole {
  SUPER_ADMIN
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  LEFT
  REMOVED
}

model Group {
  id                 String  @id @default(cuid())
  name               String
  defaultQrImageUrl  String?
  defaultBankName    String?
  defaultBankAccount String?
  defaultBankHolder  String?
  discordWebhookUrl  String?

  memberships Membership[]
  matches     Match[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id       String           @id @default(cuid())
  groupId  String
  userId   String
  role     MembershipRole   @default(MEMBER)
  status   MembershipStatus @default(ACTIVE)
  joinedAt DateTime         @default(now())
  leftAt   DateTime?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

enum MatchStatus {
  UPCOMING // created, showing estimated cost only, no payment allowed
  ONGOING // between startTime and endTime
  AWAITING_FINALIZE // endTime passed, admin has not finalized costs yet
  FINALIZED // admin locked actual costs + participant list, payments allowed
  SETTLED // all participants fully paid
}

model Match {
  id            String      @id @default(cuid())
  groupId       String
  date          DateTime
  startTime     DateTime
  endTime       DateTime
  courtLocation String
  status        MatchStatus @default(UPCOMING)

  // Proof of booking (screenshot from datlich.alobo.vn), reference only
  proofImageUrl String?

  // Optional per-match QR override; falls back to Group.defaultQrImageUrl when null
  qrImageUrl String?

  // Estimated costs, shown as "dự kiến" before finalize, view-only, never used to compute debt
  estimatedCourtFee  Int?
  estimatedWaterFee  Int?
  estimatedPerPerson Int?

  // Actual costs, set only via the finalize action; these drive real debt/payment
  actualCourtFee Int?
  actualWaterFee Int?
  actualOtherFee Int?

  finalizedAt   DateTime?
  finalizedById String?

  participations Participation[]
  payments       Payment[]

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId, date])
}

enum RsvpStatus {
  GOING
  MAYBE
  NOT_GOING
}

model Participation {
  id         String     @id @default(cuid())
  matchId    String
  userId     String
  rsvpStatus RsvpStatus @default(MAYBE)
  checkedIn  Boolean    @default(false)
  // locked = true once match is finalized; checkedIn can no longer change after that
  lockedAt   DateTime?

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, userId])
}

enum PaymentStatus {
  PENDING // amount known but nothing marked yet (only possible once match is FINALIZED)
  MARKED_PAID // member marked "đã chuyển khoản", waiting on admin confirmation
  CONFIRMED // admin confirmed receipt
}

model Payment {
  id            String        @id @default(cuid())
  matchId       String
  userId        String
  amountOwed    Int
  status        PaymentStatus @default(PENDING)
  markedPaidAt  DateTime?
  confirmedAt   DateTime?
  confirmedById String?

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  actorId   String?
  diff      Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
}
